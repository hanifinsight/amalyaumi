# PostgreSQL connection string. Use Supabase Session Pooler (port 5432) for Vercel.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Generate a random secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://aksani-api.vercel.app
CLIENT_ORIGIN=https://aksani.vercel.app

# Optional Google OAuth. Callback URL:
# https://aksani-api.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PORT=3000
